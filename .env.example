# Salin menjadi .env lalu isi. Jangan pernah commit file .env.

# Kunci Gemini API (gratis, buat di https://aistudio.google.com). Kosongkan untuk mode aturan saja.
GEMINI_API_KEY=

# Model Gemini paket gratis (opsional)
GEMINI_MODEL=gemini-3.5-flash-lite

# Matikan AI sepenuhnya: off
RAMBU_AI=on

# Batas pemeriksaan per menit per alamat IP
RAMBU_RATE=20
